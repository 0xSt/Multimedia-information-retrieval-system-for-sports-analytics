@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix wc: <http://example.org/worldcup/ontology#> .

wc:position_AM a wc:Position,
        skos:Concept ;
    skos:notation "AM" ;
    skos:prefLabel "attacking midfielder"@en .

